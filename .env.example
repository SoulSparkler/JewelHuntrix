# ----------------------------------------------------------------------------
# JewelHuntrix environment variables
# Copy to .env for local dev. In production set these in Netlify → Environment.
# NEVER commit a real .env (it is gitignored).
# ----------------------------------------------------------------------------

# Database — use the POOLED connection string (Supabase pooler :6543 / Neon).
DATABASE_URL=postgresql://user:pass@host:6543/postgres?sslmode=require

# OpenRouter (replaces direct OpenAI). One key, two models below.
OPENROUTER_API_KEY=sk-or-...
# Task A — vision scoring of listing photos (strong, accurate model)
VISION_MODEL_ID=google/gemini-2.5-flash-lite
# Task B — short Telegram message text (cheap, fast, text-only model)
MESSAGE_MODEL_ID=openai/gpt-4o-mini
# Task A2 — DETAILED manual analysis (dashboard "Manual Scan"). Stronger model;
# only runs on one-off manual scans, so the extra cost is bounded.
DETAIL_MODEL_ID=google/gemini-2.5-flash
# Vision score (1-10) at/above which a listing becomes a Telegram alert
VISION_SCORE_THRESHOLD=7

# Vinted — REGION STAYS NL. We read the public catalog anonymously (no login).
VINTED_BASE_URL=https://www.vinted.nl

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Scheduling (Netlify Scheduled Functions cron; optional overrides).
# Scans are TIME-BOXED (~20s per run, Netlify kills functions at ~30s) and
# incremental — the cron runs every 30 min so backlog clears in small bites.
# .github/workflows/scan-backstop.yml hits the same endpoint on the same
# cadence, because this Netlify schedule has silently stopped firing before.
SCAN_CRON=*/30 * * * *
HEALTH_CRON=0 8 * * *
# Per-invocation scan time budget in ms (keep under ~25000 on Netlify)
SCAN_BUDGET_MS=20000

# Local-only: run the in-process scheduler instead of Netlify cron (default off)
ENABLE_INPROCESS_SCHEDULER=false

# ----------------------------------------------------------------------------
# Scrap-metal (melt value) valuation path
#
# The second, independent valuation path: values a piece by weight x purity x
# spot price instead of by maker. Everything here is optional — with no provider
# configured the path still detects hallmarks and surfaces them, it just omits
# the euro figure rather than inventing one.
# ----------------------------------------------------------------------------

# none (default) | manual | http
#   manual = you set the prices below by hand and refresh them yourself
#   http   = reserved; no price vendor has been wired yet
METAL_PRICE_PROVIDER=none

# Used only when METAL_PRICE_PROVIDER=manual. EUR per GRAM (not per ounce).
# SPOT_PRICE_GOLD_EUR_PER_G=
# SPOT_PRICE_SILVER_EUR_PER_G=
# SPOT_PRICE_PLATINUM_EUR_PER_G=
# REQUIRED for manual: when you last read those prices. Without it the prices
# are refused outright, because an un-ageable price cannot be trusted.
# SPOT_PRICE_AS_OF=2026-08-03T00:00:00Z

# Prices older than this are flagged stale and can no longer raise an
# "underpriced vs melt" alert.
MAX_PRICE_AGE_HOURS=24
# How long a fetched price is reused before the source is re-read.
SPOT_PRICE_CACHE_MINUTES=60

# When the scrap path alone may surface a listing the vision pre-filter skipped:
#   all_hallmarks    (current default) — any solid precious-metal mark
#   underpriced_only — only a CONFIRMED-weight bargain vs melt value
#   off              — scrap never overrides the vision threshold
#
# Defaults to all_hallmarks for the test week: underpriced_only needs BOTH a
# seller-stated weight AND a live spot price, so with no price provider set it
# can never fire. Switch to underpriced_only once precision looks good.
SCRAP_ALERT_MODE=all_hallmarks

# Same, for the unmarked-metal suspicion path (no hallmark visible):
#   medium_and_high (default) | high_only | off
UNMARKED_ALERT_MODE=medium_and_high

# Shipping added to the asking price before the risk-cap and underpriced
# comparisons. Vinted jewellery shipping runs to about €3.50. NOTE: the risk
# caps in the rulesets (brand €25, scrap €10, unmarked €10) ALREADY include
# shipping — this is the shipping figure itself, not an extra allowance.
ASSUMED_SHIPPING_EUR=3.5

# Optional cost-logging price overrides (USD per 1M tokens, display only)
# VISION_PRICE_IN_PER_M=2.5
# VISION_PRICE_OUT_PER_M=10
# MESSAGE_PRICE_IN_PER_M=0.15
# MESSAGE_PRICE_OUT_PER_M=0.6
